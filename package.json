{
  "name": "all-points-burnes",
  "description": "Personal website monorepo built with Astro",
  "version": "1.0.1",
  "author": "Andrew Burnes",
  "keywords": [
    "personal site",
    "blog"
  ],
  "license": "MIT",
  "main": "n/a",
  "scripts": {
    "dev": "turbo run dev",
    "deploy": "turbo run deploy",
    "test": "turbo run test",
    "build": "turbo run build",
    "generate:llms": "pnpm --filter apps-site generate:llms",
    "check:llms": "pnpm --filter apps-site check:llms"
  },
  "devDependencies": {
    "turbo": "^2.9.16"
  },
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "qs": "^6.16.0",
    "site": "^2.60.4"
  }
}
