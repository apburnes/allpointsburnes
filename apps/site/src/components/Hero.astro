---

---

<div class="hero min-h-screen">
  <div class="hero-content flex-col lg:flex-row items-centerd lg:w-4/5">
    <div class="text-center lg:text-left lg:w-1/2 prose">
      <p class="text-3xl">
        I'm <span class="font-bold">Andrew Burnes</span>. I build web platforms
        and applications for developers.
      </p>
    </div>

    <div
      class="flex flex-col lg:w-1/2 p-8 sm:p-12 lg:py-24 items-center justify-center"
    >
      <div class="mx-auto mb-5 flex items-center justify-center w-full">
        <svg
          id="hero-logo"
          class="mx-auto h-[100px]"
          viewBox="0 0 230 170"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect
            x="60"
            y="60"
            width="20"
            height="50"
            fill="#7B92B2"></rect>
          <rect
            x="60"
            y="120"
            width="20"
            height="50"
            fill="#7B92B2"></rect>
          <rect x="150" width="20" height="50" fill="#7B92B2"
          ></rect>
          <rect
            y="60"
            width="50"
            height="50"
            rx="25"
            fill="#7B92B2"></rect>
          <rect
            x="90"
            y="60"
            width="50"
            height="50"
            rx="25"
            fill="#7B92B2"></rect>
          <rect
            x="150"
            y="60"
            width="20"
            height="50"
            fill="#7B92B2"></rect>
          <rect
            x="180"
            y="60"
            width="50"
            height="50"
            rx="25"
            fill="#7B92B2"></rect>
        </svg>
      </div>
      <h1
        class="m-5 text-2xl xl:text-3xl font-black min-h-[20px]"
      >all points burnes</h1>
    </div>
  </div>
</div>

