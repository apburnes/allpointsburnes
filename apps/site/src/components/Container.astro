---
interface Props {
  widthClass?: string;
}

const { widthClass = "w-11/12 sm:w-10/12 md:w-9/12 lg:w-8/12 xl:w-6/12" } = Astro.props;
---

<div class="container mx-auto px-3 md:px-0 py-8 flex items-center justify-center">
  <div class={`grid gap-4 grid-cols-1 ${widthClass}`}>
    <slot />
  </div>
</div>
