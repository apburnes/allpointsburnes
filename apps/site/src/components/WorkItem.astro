---
import FormattedDate from "./FormattedDate.astro";

interface Props {
  heroImage?: string;
  tags?: string[];
  title: string;
  description?: string;
  pubDate: Date;
  url: string;
}

const { heroImage, tags, title, description, pubDate, url } = Astro.props;
---

<article class="flex h-full flex-col gap-6 py-4">
  {
    heroImage && (
      <a class="w-full" href={url}>
        <img
          class="w-full rounded-box border border-base-300 object-cover object-top max-h-80"
          src={heroImage}
          alt={title}
          loading="lazy"
        />
      </a>
    )
  }
  <div class="flex flex-col justify-center items-center text-center gap-4 w-full">
    <a class="link muted-link" href={url}>
      <h2 class="card-title text-2xl muted-link">{title}</h2>
    </a>
    <p class="prose text-lg">{description}</p>
    <FormattedDate date={pubDate} />
    {
      tags?.length && tags?.length > 0 && (
        <div class="flex gap-2 flex-row flex-wrap py-2 justify-center">
          {tags.map((tag: string) => (
            <div class="badge badge-accent">{tag}</div>
          ))}
        </div>
      )
    }
  </div>
</article>
