---
import FormattedDate from "./FormattedDate.astro";
import Row from "./Row.astro";

interface Props {
  heroImage?: string;
  tags?: string[];
  title: string;
  description?: string;
  pubDate: Date;
  url: string;
}

const { heroImage, tags, title, description, pubDate, url } = Astro.props;
---

<Row>
  <div class="flex flex-col justify-start text-center items-center gap-4">
    {
      heroImage && (
        <a class="w-full" href={url}>
          <img
            class="w-full rounded-box border border-base-300 object-cover object-top max-h-64"
            src={heroImage}
            alt={title}
            loading="lazy"
          />
        </a>
      )
    }
    <a class="link muted-link" href={url}>
      <h2 class="card-title text-2xl muted-link">{title}</h2>
    </a>
    <p class="prose text-center text-lg mx-auto">{description}</p>
    <FormattedDate date={pubDate} />
    {
      tags && tags.length > 0 && (
        <div class="flex gap-2 flex-row flex-wrap py-4">
          {tags.map((tag: string) => (
            <div class="badge badge-accent">{tag}</div>
          ))}
        </div>
      )
    }
  </div>
</Row>
